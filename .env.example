# Planet Stopper — .env template
#
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control — it contains real credentials.
# This file (.env.example) contains only placeholder values and IS tracked.
#
# Mode 600 recommended:  chmod 600 .env

# ---------------------------------------------------------------------------
# EXECUTION MODE (REQUIRED)
# ---------------------------------------------------------------------------

# Leave False until dry-run validation is complete.
# Set True only on a machine you intend to live-trade from.
# The production droplet MUST remain False — it is shadow/advisory only.
LIVE_EXECUTION='False'

EXECUTION_START_TIME=09:30

# ---------------------------------------------------------------------------
# DASHBOARD AUTH (REQUIRED for public deployment)
# ---------------------------------------------------------------------------

# Preferred: werkzeug hash (pbkdf2:sha256:... / scrypt:... / bcrypt:...)
# Generate with: python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('yourpassword'))"
DASHBOARD_PASSWORD_HASH=

# Fallback plaintext (only used when DASHBOARD_PASSWORD_HASH is absent).
# Prefer DASHBOARD_PASSWORD_HASH for public deployments.
DASHBOARD_PASSWORD=

# Flask session signing key.  Required; fail-closed if absent or empty.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Optional alias for SECRET_KEY (either works; SECRET_KEY takes precedence).
# FLASK_SECRET_KEY=

# Set to 'true' or '1' to add Secure flag to the session cookie.
# Enable when TLS terminates at a reverse proxy (e.g., Caddy / nginx).
SESSION_COOKIE_SECURE=

# Set to '1' to trust X-Forwarded-For for client-IP throttle keying.
# Enable only when behind a trusted reverse proxy.
TRUST_PROXY=

# ---------------------------------------------------------------------------
# COMPOSER.TRADE (REQUIRED for live engine)
# ---------------------------------------------------------------------------

COMPOSER_KEY_ID=
COMPOSER_SECRET=

# Account UUIDs — set whichever accounts you use.
ACCOUNT_INDIVIDUAL=
ACCOUNT_ROTH=
ACCOUNT_TRAD=

# ---------------------------------------------------------------------------
# ALPACA (REQUIRED for price data and walk-forward)
# ---------------------------------------------------------------------------

ALPACA_KEY=
ALPACA_SECRET=

# ---------------------------------------------------------------------------
# DISCORD (REQUIRED for exit alerts and post-mortems)
# ---------------------------------------------------------------------------

DISCORD_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# ANTHROPIC (OPTIONAL — enables AI Advisor suggestions + chat)
# ---------------------------------------------------------------------------

# Used by the on-demand Flask advisor (SDK path, direct call).
# NOT used by the nightly Market Prism council subprocess — the council
# uses CLAUDE_CODE_OAUTH_TOKEN instead (see DISABLE_DAEMON_LENS_PIPELINE).
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# MARKET PRISM COUNCIL (production droplet settings)
# ---------------------------------------------------------------------------

# Set to 1 on the droplet to silence the daemon's 03:00 lens-pipeline slot
# so the council (prism_scheduler.py) is the SOLE nightly MARKET_PRISM producer.
# SAFE TRANSITION ORDER: set this flag + restart daemon BEFORE enabling the
# council systemd timer.  See docs/DEPLOYMENT.md §Step 8.
DISABLE_DAEMON_LENS_PIPELINE=

# OAuth token for the nightly council subprocess.
# Obtained via: claude setup-token
# The council pops ANTHROPIC_API_KEY from its subprocess env and falls back
# to this token (Claude subscription billing, not metered API).
# Prefer storing this in a root-600 systemd EnvironmentFile rather than .env.
# CLAUDE_CODE_OAUTH_TOKEN=

# ---------------------------------------------------------------------------
# FRED (OPTIONAL — enables macro lens)
# ---------------------------------------------------------------------------

FRED_API_KEY=

# ---------------------------------------------------------------------------
# MONGODB ATLAS (OPTIONAL — enables community strategy loader)
# ---------------------------------------------------------------------------

MONGO_URI=

# Atlas cache TTL in days (default 7).  Protects provider billing.
# ATLAS_CACHE_TTL_DAYS=7

# ---------------------------------------------------------------------------
# ALGORITHM PARAMETERS (tunable; autotuner overrides these after a run)
# ---------------------------------------------------------------------------

TRIGGER_THRESHOLD_PCT=15.0
TAKE_PROFIT_MC_PCT=5.0
VWAP_CROSS_HWM_PCT=1.0
PARABOLIC_VELOCITY_THRESHOLD=2.0
MAX_PARABOLIC_SQUEEZE=0.50
MAX_SQUEEZE_FLOOR=0.20
VWAP_OPEN_WINDOW_GRACE_MINUTES=15

# ---------------------------------------------------------------------------
# OPTIONAL / ADVANCED
# ---------------------------------------------------------------------------

# Model for AI Advisor synthesis (default: claude-opus-4-8).
# ADVISOR_SYNTHESIS_MODEL=claude-opus-4-8

# Dashboard port (default: 5000 locally; use 8090 on the droplet behind Caddy).
# PORT=5000

# Leave off (0) unless you want the Divergence Explainer second CVaR window.
SECOND_WINDOW_CVAR_ENABLED=0
