Your keys:
.env
.env.*
!.env.example

# Local Databases (Your personal strategy locks and bot state)
alphabot_state.db
optuna_studies.db

# Caches and Post-Mortem Reports (Your personal daily returns)
__pycache__/
cache/
history_cache.json
symphony_logs.json
post_mortem_*.json
# ...but captured-from-producer test fixtures are versioned
!tests/fixtures/**/post_mortem_*.json

# Test / lint artefacts
.coverage
.pytest_cache/
.ruff_cache/
htmlcov/

# SQLite journal/WAL files (*.db itself is NOT ignored — may be tracked or excluded separately)
*.db-journal
*.db-wal
*.db-shm
coverage.json

# runtime artifacts (regenerated by the daemon — never track)
alphabot_daemon.log
alphabot_daemon.out.log
alphabot_daemon.err.log
alphabot.pid
*.db-wal
*.db-shm

# SQLite database files (defense-in-depth — keep *.db out of history)
*.db
*.db.*backup
*.db.postDryRun
*.db.preDryRun*
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm

# Ad-hoc scratch DB_PATH targets used for local/manual test runs (e.g.
# `DB_PATH="$PWD/.scratch_seam.sqlite" pytest ...`) — .sqlite is already
# covered above, this also catches any extension variant of the convention.
.scratch_*

# Operational dry-run artifacts
.dry-run-smoke.*

# Claude agent infrastructure (worktrees, heartbeats, audit worktrees)
.claude/worktrees/
.claude/audit-worktrees/
.claude/heartbeats/

# Screenshot artifacts from UX review passes (ux-*.png etc.)
ux-*.png
.design-handoff/screenshots/

# Playwright MCP cache
.playwright-mcp/
.claude/settings.local.json

# TDD cycle handoff file (per-cycle, never committed — recreated by test-writer)
.claude/tdd-handoff.md

# Real database backups taken before a restart or a cleanup (alphabot_state.db.pre-*, optuna_studies.db.pre-*)
# and their SQLite -shm / -wal companions; the repository is public, so one `git add -A` would publish them
*.db.*
*.db-*

# Private keys, certificates, logs and credentials files
*.key
*.pem
*.log
credentials.json
*credentials*.json
# ...but captured-from-producer test fixtures are versioned (an invalid-credentials 401 answer is not a credential)
!tests/fixtures/**/*credentials*.json
.claude/archive/
